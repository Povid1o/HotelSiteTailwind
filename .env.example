POSTGRES_DB=HotelSite
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-jwt-secret
SECRET_KEY=replace-with-a-long-random-legacy-secret
CORS_ORIGIN=
# HTTP разрешён только для localhost; production override всегда включает Secure-cookie.
COOKIE_SECURE=false
# Номер счётчика Яндекс Метрики (metrika.yandex.ru); пусто — аналитика выключена
YM_ID=
# OAuth-токен с доступом metrika:read — для раздела «Аналитика» в админке
YM_TOKEN=
# Почта для отправки заявок на вино. Адрес получателя задаётся в админке → Вина.
# SMTP_FROM должен быть разрешён почтовым провайдером для SMTP_USER.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PUBLIC_SITE_URL=http://localhost:8081
